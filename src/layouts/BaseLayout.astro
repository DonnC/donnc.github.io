---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; canonical?: string; article?: boolean; }
const { title = 'Donald Chinhuru — Payments, mobile & business platforms', description = 'Senior software engineer building payment systems, mobile banking and business platforms. Explore work by Donald Chinhuru, PMP.', canonical, article = false } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title.includes('Donald Chinhuru') ? title : `${title} — Donald Chinhuru`;
---
<!doctype html><html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title><meta name="description" content={description} /><meta name="theme-color" content="#183f36" />
  <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin /><link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title="Donald Chinhuru — Writing" href="/writing/rss.xml" />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:site_name" content="Donald Chinhuru" />
  <meta property="og:image" content={new URL('/social.png', Astro.site).href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Donald Chinhuru — Payments. Platforms. Built to connect." /><meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: 'Donald Chinhuru', url: Astro.site?.href, jobTitle: 'Senior Software Engineer', sameAs: ['https://github.com/DonnC'], knowsAbout: ['Payment systems', 'Mobile development', 'Business process automation', 'Frappe', 'ERPNext'] })} />
</head><body id="top"><a class="skip-link" href="#main">Skip to content</a><div class="wrap"><Nav /></div><main id="main"><slot /></main><Footer /></body></html>
